# ============================================================
# ARCHIVO: .env.example
# Responsabilidad: Documentar las variables de entorno que el
# backend necesita. Copiar a ".env" y rellenar los valores.
# NUNCA subir el archivo .env real al repositorio.
# ============================================================

# Puerto del servidor Express (Render lo inyecta)
PORT=4000

# Configuracion de base de datos PostgreSQL
DB_HOST=db.xxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password
DB_SCHEMA=barberia
DB_SSL=true

# JWT - Clave secreta para firmar tokens
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES_IN=24h

# CORS - Origen permitido del frontend
CORS_ORIGIN=https://tu-frontend.vercel.app
