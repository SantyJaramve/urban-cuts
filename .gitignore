# ============================================================
# ARCHIVO: .gitignore
# RESPONSABILIDAD: Excluir del control de versiones los
# archivos y carpetas que no deben subirse al repositorio:
# dependencias, builds, variables de entorno y credenciales.
# ============================================================

# Dependencias
node_modules/
backend/node_modules/
frontend/node_modules/

# Builds
frontend/dist/
dist/
build/

# Variables de entorno y credenciales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
credenciales.txt
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo
Thumbs.db
.DS_Store

# Editor
.vscode/
.idea/
*.swp
